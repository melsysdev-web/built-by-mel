---
interface Props {
    lang?: "en" | "es";
}

const { lang = "en" } = Astro.props;

const translations = {
    en: {
        tagline: "Building digital experiences with purpose.",
        navigation: "Navigation",
        home: "Home",
        education: "Education",
        projects: "Projects",
        contact: "Contact",
        role: "Systems Engineer",
        location: "El Salvador",
        copyright: "All rights reserved.",
        built: "Designed & developed with",
        backToTop: "Back to top",
    },
    es: {
        tagline: "Creando experiencias digitales con propósito.",
        navigation: "Navegación",
        home: "Inicio",
        education: "Educación",
        projects: "Proyectos",
        contact: "Contacto",
        role: "Ingeniero en Sistemas",
        location: "El Salvador",
        copyright: "Todos los derechos reservados.",
        built: "Diseñado y desarrollado con",
        backToTop: "Volver arriba",
    },
};

const t = translations[lang];
const basePath = lang === "es" ? "/es/" : "/";
---

<footer class="border-t border-border bg-surface">
    <div class="mx-auto max-w-6xl px-5 sm:px-6">
        <div class="grid gap-10 py-12 sm:py-14 md:grid-cols-2 md:gap-12 lg:grid-cols-3">
            <!-- Identidad profesional -->
            <div class="space-y-4">
                <a
                    href={basePath}
                    class="group inline-flex items-center gap-3"
                    aria-label="Melvin Rodriguez - Inicio"
                >
                    <span class="flex size-10 items-center justify-center rounded-xl border border-primary/20 bg-primary/10 text-primary transition-colors duration-300 group-hover:bg-primary/15">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.7"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            class="size-5"
                            aria-hidden="true"
                        >
                            <path d="m8 8-4 4 4 4" />
                            <path d="m16 8 4 4-4 4" />
                            <path d="m14 5-4 14" />
                        </svg>
                    </span>

                    <span class="font-display text-base font-bold tracking-tight text-foreground">
                        Melvin Rodriguez
                    </span>
                </a>

                <p class="max-w-xs text-sm leading-6 text-foreground/65">
                    {t.tagline}
                </p>

                <p class="text-xs font-medium tracking-wide text-primary">
                    {t.role}
                </p>
            </div>

            <!-- Navegación -->
            <div class="space-y-4">
                <h2 class="text-xs font-semibold uppercase tracking-[0.18em] text-foreground/45">
                    {t.navigation}
                </h2>

                <nav aria-label={t.navigation} class="flex flex-col items-start gap-3">
                    <a href={`${basePath}#home`} class="text-sm text-foreground/70 transition-colors hover:text-primary">
                        {t.home}
                    </a>
                    <a href={`${basePath}#education`} class="text-sm text-foreground/70 transition-colors hover:text-primary">
                        {t.education}
                    </a>
                    <a href={`${basePath}#projects`} class="text-sm text-foreground/70 transition-colors hover:text-primary">
                        {t.projects}
                    </a>
                    <a href={`${basePath}#contact`} class="text-sm text-foreground/70 transition-colors hover:text-primary">
                        {t.contact}
                    </a>
                </nav>
            </div>

            <!-- Ubicación y regreso al inicio -->
            <div class="flex flex-col items-start gap-4">
                <h2 class="text-xs font-semibold uppercase tracking-[0.18em] text-foreground/45">
                    {t.location}
                </h2>

                <p class="text-sm text-foreground/75">
                    {t.location}
                </p>

                <a
                    href={`${basePath}#home`}
                    class="flex w-fit items-center gap-2 pt-1 text-sm text-foreground/60 transition-colors hover:text-primary"
                >
                    {t.backToTop}
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="size-4"
                        aria-hidden="true"
                    >
                        <path d="M12 19V5" />
                        <path d="m5 12 7-7 7 7" />
                    </svg>
                </a>
            </div>
        </div>

        <!-- Barra inferior -->
        <div class="flex flex-col gap-3 border-t border-border py-5 text-xs text-foreground/50 sm:flex-row sm:items-center sm:justify-between">
            <p>
                © {new Date().getFullYear()} Melvin Rodriguez. {t.copyright}
            </p>

            <p class="flex flex-wrap items-center gap-1.5">
                {t.built}
                <span class="font-medium text-primary">Astro</span>
                <span aria-hidden="true">·</span>
                <span>Tailwind CSS</span>
            </p>
        </div>
    </div>
</footer>