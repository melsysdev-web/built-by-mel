---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
    degree: string;
    institution: string;
    period: string;
    description?: string;
    logo: ImageMetadata;
    alt: string;
    active?: boolean;
}

const {
    degree,
    institution,
    period,
    description,
    logo,
    alt,
    active = false,
} = Astro.props;
---

<div
    class="relative pl-8 border-l border-border hover:border-primary/50 transition-colors py-2"
>
    <!-- Timeline point -->
    <div
        class={`absolute -left-1 top-4 size-2 rounded-full ${
            active
                ? "bg-primary ring-4 ring-primary/20"
                : "bg-border"
        }`}
    ></div>

    <div class="flex gap-5 items-start">

        <!-- University Logo -->
        <div
            class="shrink-0 size-16 rounded-xl border border-border bg-surface flex items-center justify-center overflow-hidden"
        >
            <Image
                src={logo}
                alt={alt}
                class="w-12 h-12 object-contain"
            />
        </div>

        <!-- Academic Information -->
        <div class="flex-1">

            <div
                class="flex flex-col md:flex-row md:items-baseline justify-between gap-2 mb-2"
            >
                <h3 class="text-xl font-bold text-foreground">
                    {degree}
                </h3>

                <span
                    class="text-sm text-surface-foreground/70 font-mono whitespace-nowrap"
                >
                    {period}
                </span>
            </div>

            <p class="text-primary font-medium mb-3 text-sm">
                {institution}
            </p>

            {
                description && (
                    <p class="text-foreground/60 text-sm leading-relaxed max-w-3xl">
                        {description}
                    </p>
                )
            }

        </div>
    </div>
</div>