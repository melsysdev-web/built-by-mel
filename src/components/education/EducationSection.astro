---
import AcademicBackground from "./AcademicBackground.astro";
import logo1 from "../../assets/logo_azul_vertical.webp";
import logo2 from "../../assets/infravenz.webp";


const education = [
    {
        degree: "Systems and Computer Networks Engineers",
        institution: "Universidad Gerardo Barrios",
        period: "2021 — PRESENT",
        description:
            "As a professional graduate in Systems and Computer Network Engineering, I developed the necessary skills to integrate technology within institutional processes, applying software development, implementation of computer networks, database administration and management, information security, server administration, IT project management, business intelligence, and emerging technologies to solve problems related to information, data, and communication associated with these processes; doing so critically, contributing to social development, and under an ethical approach.",
        logo: logo1,
        alt: "Logo de la Universidad Gerardo Barrios",
        active: true,
    },
    {
        degree: "Vocational Technical Baccalaureate in Software Development",
        institution: "Instituto Nacional Profesor Francisco Ventura Zelaya",
        period: "2018 — 2020",
        description:
            "I laid the foundations of my education by acquiring the skills for the analysis, design, implementation, and monitoring of enterprise software applications, applying technology oriented towards the web and mobile devices.",
        logo: logo2,
        alt: "Logo de la Universidad Gerardo Barrios",
        active: false,
    },
];
---

<section class="max-w-6xl mx-auto px-6 py-24" id="education">
    <div class="flex items-center justify-between mb-16">
        <div>
            <h2 class="text-2xl font-bold text-foreground">
                Education
            </h2>

            <p class="text-surface-foreground/70">
                Academic background and continuous learning.
            </p>
        </div>

        <span
            class="hidden md:block text-xs font-mono text-surface-foreground/70"
        >
            01 / EDUCATION
        </span>
    </div>

    <div class="space-y-12">
        {
            education.map((item) => (
                <AcademicBackground {...item} />
            ))
        }
    </div>
</section>