---
import { Image } from "astro:assets";

interface Props {
    title: string;
    issuer: string;
    year: string;
    image: string;
    alt: string;
    link?: string;
}

const { title, issuer, year, image, alt, link } = Astro.props;
---

<div
    class="group p-6 rounded-xl bg-surface border border-border hover:border-primary/40 transition-all flex flex-col justify-between"
>
    <!-- Certificate image -->
    <div
        class="w-full h-48 flex items-center justify-center rounded-lg mb-6 overflow-hidden bg-background border border-border/50">
        <Image
            src={image}
            alt={alt}
            loading="lazy"
            class="w-full h-full object-contain object-center group-hover:scale-105 transition-transform duration-500"
        />
    </div>

    <!-- Certification information -->
    <div>
        <div class="flex items-center justify-between gap-4 mb-3">
            <h3
                class="text-lg font-semibold text-foreground group-hover:text-primary transition-colors"
            >
                {title}
            </h3>

            <span
                class="inline-flex shrink-0 items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium bg-primary/10 text-primary border border-primary/20"
            >
                <span class="size-1.5 rounded-full bg-primary"></span>
                Certified
            </span>
        </div>

        <p class="text-sm text-surface-foreground mb-4">
            {issuer}
        </p>
    </div>

    <!-- Footer -->
    <div
        class="pt-4 border-t border-border/40 flex items-center justify-between text-xs font-mono text-surface-foreground/60"
    >
        <span>{year}</span>

        {
            link && (
                <a
                    href={link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1 text-primary hover:text-foreground transition-colors"
                >
                    <span>View credential</span>

                    <span class="font-icon text-sm">
                        arrow_outward
                    </span>
                </a>
            )
        }
    </div>
</div>
