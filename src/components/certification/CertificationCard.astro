---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
    title: string;
    issuer: string;
    year: string;
    image: ImageMetadata;
    alt: string;
    link?: string;
}

const { title, issuer, year, image, alt, link } = Astro.props;
---

<div
    class="group flex flex-col p-6 rounded-xl bg-surface border border-border
    md:hover:border-primary/40
    md:hover:-translate-y-1
    shadow-sm
    md:hover:shadow-md
    transition-all duration-300"
>
    <!-- Certificate Image -->
    <div
        class="relative w-full rounded-lg mb-6 overflow-hidden bg-background border border-border/50"
    >
        <Image
            src={image}
            alt={alt}
            loading="lazy"
            class="w-full h-auto object-center md:grayscale md:group-hover:grayscale-0 md:group-hover:scale-[1.02] transition-all duration-500"
        />

        <!-- Image overlay -->
        <div
            class="absolute inset-0 bg-primary/5 opacity-0 md:group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"
        ></div>
    </div>

    <!-- Certification Information -->
    <div class="flex-1">
        <div class="flex items-start justify-between gap-4 mb-2">
            <h3
                class="text-lg font-semibold text-foreground leading-snug
                md:group-hover:text-primary
                active:text-primary
                transition-colors"
            >
                {title}
            </h3>

            <span
                class="shrink-0 text-[10px] font-mono uppercase tracking-wider
                text-primary/70 border border-primary/20
                bg-primary/5 px-2 py-1 rounded"
            >
                Certified
            </span>
        </div>

        <p class="text-sm text-surface-foreground/70 leading-relaxed">
            {issuer}
        </p>
    </div>

    <!-- Footer -->
    <div
        class="mt-6 pt-4 border-t border-border/40 flex items-center justify-between"
    >
        <span
            class="text-xs font-mono text-surface-foreground/60"
        >
            {year}
        </span>

        {
            link && (
                <a
                    href={link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1.5 text-xs font-medium
                    text-primary hover:text-foreground
                    transition-colors"
                >
                    <span>View credential</span>

                    <span class="font-icon text-sm">
                        arrow_outward
                    </span>
                </a>
            )
        }
    </div>
</div>
