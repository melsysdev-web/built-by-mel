---
interface Props {
    lang?: "en" | "es";
}

const { lang = "en" } = Astro.props;

const translations = {
    en: {
        education: "Education",
        projects: "Projects",
        certifications: "Certifications",
        expertise: "Expertise",
        resume: "Resume",
    },
    es: {
        education: "Educación",
        projects: "Proyectos",
        certifications: "Certificaciones",
        expertise: "Experiencia",
        resume: "Currículum",
    },
};

const t = translations[lang];
---

<nav
    id="mobile-menu"
    aria-hidden="true"
    class="md:hidden hidden px-6 pb-6 bg-glass-panel border-t border-border"
>
    <div class="flex flex-col gap-2 pt-4">

        <!-- Education -->
        <a
            class="mobile-link py-2 text-sm font-medium hover:text-secondary transition-colors"
            href="#education"
        >
            {t.education}
        </a>

        <!-- Projects -->
        <a
            class="mobile-link py-2 text-sm font-medium hover:text-secondary transition-colors"
            href="#projects"
        >
            {t.projects}
        </a>

        <!-- Certifications -->
        <a
            class="mobile-link py-2 text-sm font-medium hover:text-secondary transition-colors"
            href="#certifications"
        >
            {t.certifications}
        </a>

        <!-- Expertise -->
        <a
            class="mobile-link py-2 text-sm font-medium hover:text-secondary transition-colors"
            href="#expertise"
        >
            {t.expertise}
        </a>

        <!-- Resume / Contact -->
        <a
            class="mobile-link py-2 text-sm font-medium hover:text-secondary transition-colors"
            href="#contact"
        >
            {t.resume}
        </a>

    </div>
</nav>