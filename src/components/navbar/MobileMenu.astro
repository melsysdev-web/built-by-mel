---
interface Props {
    lang?: "en" | "es";
}

const { lang = "en" } = Astro.props;

const translations = {
    en: {
        education: "Education",
        projects: "Projects",
        certifications: "Certifications",
        expertise: "Expertise",
        resume: "Resume",
        navigation: "Navigation",
    },
    es: {
        education: "Educación",
        projects: "Proyectos",
        certifications: "Certificaciones",
        expertise: "Experiencia",
        resume: "Contacto",
        navigation: "Navegación",
    },
};

const t = translations[lang];

const links = [
    { label: t.education, href: "#education", number: "01" },
    { label: t.projects, href: "#projects", number: "02" },
    { label: t.certifications, href: "#certifications", number: "03" },
    { label: t.expertise, href: "#expertise", number: "04" },
    { label: t.resume, href: "#contact", number: "05" },
];
---

<nav
    id="mobile-menu"
    aria-label={t.navigation}
    aria-hidden="true"
    inert
    class="md:hidden hidden border-t border-border bg-glass-panel"
>
    <div class="mx-auto w-full max-w-lg px-5 pb-6 pt-5 sm:px-6">
        <p
            class="mb-3 px-3 text-xs font-semibold uppercase tracking-[0.2em] text-muted"
        >
            {t.navigation}
        </p>

        <div class="flex flex-col gap-1">
            {links.map((link) => (
                <a
                    class="mobile-link group flex min-h-12 items-center justify-between rounded-xl px-3 py-3 text-sm font-medium text-foreground transition-colors duration-200 hover:bg-primary/10 hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary active:bg-primary/15"
                    href={link.href}
                >
                    <span>{link.label}</span>

                    <span class="flex items-center gap-3">
                        <span class="text-xs tabular-nums text-muted transition-colors group-hover:text-primary">
                            {link.number}
                        </span>

                        <span
                            aria-hidden="true"
                            class="text-lg text-muted transition-transform duration-200 group-hover:translate-x-1 group-hover:text-primary"
                        >
                            →
                        </span>
                    </span>
                </a>
            ))}
        </div>

        <div
            class="mt-5 h-px w-full bg-gradient-to-r from-primary/40 via-border to-transparent"
            aria-hidden="true"
        />
    </div>
</nav>