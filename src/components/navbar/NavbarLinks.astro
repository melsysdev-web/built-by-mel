
---
interface Props {
    lang?: "en" | "es";
}

const { lang = "en" } = Astro.props;

const translations = {
    en: {
        education: "Education",
        projects: "Projects",
        certifications: "Certifications",
        expertise: "Expertise",
        resume: "Resume",
    },
    es: {
        education: "Educación",
        projects: "Proyectos",
        certifications: "Certificaciones",
        expertise: "Experiencia",
        resume: "Contacto",
    },
};

const t = translations[lang];
const basePath = lang === "es" ? "/es/" : "/";
---

<a
    class="text-sm font-medium transition-colors hover:text-secondary"
    href={`${basePath}#education`}
>
    {t.education}
</a>

<a
    class="text-sm font-medium transition-colors hover:text-secondary"
    href={`${basePath}#projects`}
>
    {t.projects}
</a>

<a
    class="text-sm font-medium transition-colors hover:text-secondary"
    href={`${basePath}#certifications`}
>
    {t.certifications}
</a>

<a
    class="text-sm font-medium transition-colors hover:text-secondary"
    href={`${basePath}#expertise`}
>
    {t.expertise}
</a>

<a
    class="rounded-lg bg-primary px-5 py-2 font-bold text-primary-foreground transition-all hover:bg-primary/90"
    href={`${basePath}#contact`}
>
    {t.resume}
</a>
