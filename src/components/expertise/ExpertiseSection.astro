---
import SkillCard from "./SkillCard.astro";

interface Props {
    lang?: "en" | "es";
}

const { lang = "en" } = Astro.props;

const skills = [
    {
        icon: "code_blocks",
        en: {
            title: "Backend Development",
            items: [
                { name: "Python / FastAPI", level: "Advanced" },
                { name: "REST APIs", level: "Intermediate" },
                { name: "SQL & Databases", level: "Intermediate" },
            ],
        },
        es: {
            title: "Desarrollo Backend",
            items: [
                { name: "Python / FastAPI", level: "Avanzado" },
                { name: "REST APIs", level: "Intermedio" },
                { name: "SQL y Bases de Datos", level: "Intermedio" },
            ],
        },
    },
    {
        icon: "psychology",
        en: {
            title: "Artificial Intelligence",
            items: [
                { name: "Machine Learning", level: "Intermediate" },
                { name: "AI Integration", level: "Intermediate" },
                { name: "NLP", level: "Basic" },
            ],
        },
        es: {
            title: "Inteligencia Artificial",
            items: [
                { name: "Machine Learning", level: "Intermedio" },
                { name: "Integración de IA", level: "Intermedio" },
                { name: "NLP", level: "Básico" },
            ],
        },
    },
    {
        icon: "language",
        en: {
            title: "Web Development",
            items: [
                { name: "Astro / JavaScript", level: "Advanced" },
                { name: "HTML / CSS / Tailwind", level: "Advanced" },
                { name: "Laravel / PHP", level: "Advanced" },
            ],
        },
        es: {
            title: "Desarrollo Web",
            items: [
                { name: "Astro / JavaScript", level: "Avanzado" },
                { name: "HTML / CSS / Tailwind", level: "Avanzado" },
                { name: "Laravel / PHP", level: "Avanzado" },
            ],
        },
    },
    {
        icon: "lan",
        en: {
            title: "Infrastructure & Networking",
            items: [
                { name: "Docker", level: "Intermediate" },
                { name: "Git / GitHub", level: "Advanced" },
                { name: "Computer Networking", level: "Intermediate" },
            ],
        },
        es: {
            title: "Infraestructura y Redes",
            items: [
                { name: "Docker", level: "Intermedio" },
                { name: "Git / GitHub", level: "Avanzado" },
                { name: "Redes Informáticas", level: "Intermedio" },
            ],
        },
    },
];

const translations = {
    en: {
        title: "Core Expertise",
        description:
            "My technical stack combines backend development, artificial intelligence, web technologies, and infrastructure to build reliable and scalable digital solutions.",
        badge: "Systems Engineering",
    },
    es: {
        title: "Competencias Técnicas",
        description:
            "Mi perfil técnico combina desarrollo backend, inteligencia artificial, tecnologías web e infraestructura para construir soluciones digitales confiables y escalables.",
        badge: "Ingeniería de Sistemas",
    },
};

const t = translations[lang];
---

<section class="bg-surface/20 py-24" id="expertise">
    <div class="max-w-6xl mx-auto px-6">
        <div class="flex flex-col md:flex-row gap-16">

            <!-- Section information -->
            <div class="md:w-1/3">
                <h2 class="text-2xl font-bold text-foreground mb-4">
                    {t.title}
                </h2>

                <p class="text-foreground/60 leading-relaxed mb-6">
                    {t.description}
                </p>

                <div
                    class="inline-flex items-center gap-2 text-primary font-medium text-sm"
                >
                    <span class="font-icon text-base">verified</span>
                    <span>{t.badge}</span>
                </div>
            </div>

            <!-- Skills -->
            <div class="md:w-2/3 grid grid-cols-1 sm:grid-cols-2 gap-10">
                {
                    skills.map((skill) => (
                        <SkillCard
                            title={skill[lang].title}
                            icon={skill.icon}
                            items={skill[lang].items}
                        />
                    ))
                }
            </div>

        </div>
    </div>
</section>
