---
import "@fontsource-variable/inter";
import "@fontsource/material-icons-outlined";
import "@fontsource-variable/material-symbols-outlined";

import "../styles/global.css";

import Navbar from "../components/navbar/Navbar.astro";
import Footer from "../components/footer/Footer.astro";
import LanguageLoader from "../components/loader/LanguageLoader.astro";
interface Props {
    lang?: "en" | "es";
}

const { lang = "en" } = Astro.props;
---

<!doctype html>
<html lang={lang} class="h-full w-full">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />

        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />

        <meta name="generator" content={Astro.generator} />

        <title>Portfolio Melvin Rodriguez</title>

        <!-- Theme initialization -->
        <script is:inline>
            (() => {
                const theme = localStorage.getItem("theme");

                if (
                    theme === "dark" ||
                    (!theme &&
                        window.matchMedia("(prefers-color-scheme: dark)").matches)
                ) {
                    document.documentElement.classList.add("dark");
                } else {
                    document.documentElement.classList.remove("dark");
                }
            })();
        </script>

        <!-- Language transition -->
        <script is:inline>
            document.addEventListener("DOMContentLoaded", () => {
                document.querySelectorAll("a[data-language]").forEach((link) => {
                    link.addEventListener("click", (event) => {
                        const href = link.getAttribute("href");

                        if (!href) return;

                        event.preventDefault();

                        document.documentElement.classList.add(
                            "language-transition-out"
                        );

                        setTimeout(() => {
                            window.location.href = href;
                        }, 250);
                    });
                });
            });
        </script>
    </head>

    <body
        class="bg-background text-foreground font-body m-0 h-full w-full" >
        <LanguageLoader />
        <Navbar lang={lang} />

        <main class="pt-20">
            <slot />
        </main>

        <Footer lang={lang} />
    </body>
</html>
