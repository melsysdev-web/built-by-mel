---
import "@fontsource-variable/inter";
import "@fontsource/material-icons-outlined";
import "@fontsource-variable/material-symbols-outlined";

import "../styles/global.css";

import Navbar from "../components/navbar/Navbar.astro";
import Footer from "../components/footer/Footer.astro";
import LanguageLoader from "../components/loader/LanguageLoader.astro";

interface Props {
    lang?: "en" | "es";
}

const { lang = "en" } = Astro.props;
---

<!doctype html>
<html lang={lang} class="h-full w-full">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />

        <link rel="icon" type="image/svg+xml" href="/mel.svg" />
        <link rel="icon" href="/mel.ico" />
        <meta name="generator" content={Astro.generator} />
        <meta
            name="description"
            content="Portfolio of Melvin Rodriguez, Systems Engineer focused on software development, backend technologies, and intelligent applications."
        />

        <title>Portfolio Melvin Rodriguez</title>

        <!-- Material Symbols initialization -->
        <script is:inline>
            (() => {
                const root = document.documentElement;
                const font = '24px "Material Symbols Outlined Variable"';

                const enableIcons = () => {
                    root.classList.add("icons-ready");
                };

                if (document.fonts.check(font)) {
                    enableIcons();
                } else {
                    document.fonts.load(font).then(enableIcons).catch(() => {
                        // Keep icons hidden if the font fails to load.
                    });
                }
            })();
        </script>

        <!-- Theme initialization -->
        <script is:inline>
            (() => {
                const root = document.documentElement;

                try {
                    const savedTheme = localStorage.getItem("theme");
                    const prefersDark = window.matchMedia(
                        "(prefers-color-scheme: dark)"
                    ).matches;

                    const useDark =
                        savedTheme === "dark" ||
                        (savedTheme !== "light" && prefersDark);

                    root.classList.toggle("dark", useDark);
                } catch {
                    root.classList.toggle(
                        "dark",
                        window.matchMedia("(prefers-color-scheme: dark)").matches
                    );
                }
            })();
        </script>

        <!-- Language transition -->
        <script is:inline>
            document.addEventListener("DOMContentLoaded", () => {
                document.querySelectorAll("a[data-language]").forEach((link) => {
                    link.addEventListener("click", (event) => {
                        const href = link.getAttribute("href");

                        if (!href) return;

                        event.preventDefault();

                        document.body.classList.add("language-transition-out");

                        window.setTimeout(() => {
                            window.location.href = href;
                        }, 250);
                    });
                });
            });
        </script>
    </head>

    <body class="m-0 min-h-full w-full bg-background font-body text-foreground">
        <LanguageLoader />

        <Navbar lang={lang} />

        <main class="pt-16 sm:pt-20">
            <slot />
        </main>

        <Footer lang={lang} />
    </body>
</html>
